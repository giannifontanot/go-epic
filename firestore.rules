rules_version = '2';

// Each person reads and writes only their own data: users/{uid}/week/{DAY}, users/{uid}/days/{date}, users/{uid}/library/tree,
// users/{uid}/todos/{id} (Capture's tasks), users/{uid}/dates/{YYYY-MM-DD} (the Year's important dates),
// users/{uid}/sprints/{first day} (each sprint's plan and reflection), users/{uid}/settings/ai (the person's own Claude key).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
